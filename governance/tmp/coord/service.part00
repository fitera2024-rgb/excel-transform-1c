+        if saved_key:
+            saved = catalog.get(saved_key)
+            if saved:
+                return saved, None
+            return None, "Сохранённый ЦФО Инталев отсутствует в текущем классификаторе"
+        return None, "Исходный ЦФО не сопоставлен с ЦФО Инталев"
+
