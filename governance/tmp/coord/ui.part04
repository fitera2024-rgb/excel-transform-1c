idden" name="source_cfo" value="{{ entry.source_cfo }}"><label>ЦФО Инталев<select name="intalev_source_key" data-cfo-intalev><option value="">Выберите точный ЦФО Инталев</option>{% for option in intalev_cfo_options %}<option value="{{ option.source_key }}"{% if option.source_key == entry.intalev_source_key %} selected{% endif %}>{{ option.label }}</option>{% endfor %}</select></label><label>ЦФО / подразделение / узел 1С<select name="target_node_id" data-cfo-target><option value="">Выберите точный узел 1С</option>{% for option in organization_options %}<option value="{{ option.node_id }}"{% if option.node_id == entry.target_node_id %} selected{% endif %}>{{ option.label }}</option>{% endfor %}</select></label><label><input type="checkbox" name="confirmed" value="1" data-cfo-confirm disabled>Подтверждаю оба соответствия ЦФО</label><button type="submit" data-cfo-submit disabled>Сначала выберите оба значения и поставьте галку</button><small>{{ entry.status }}</small></form>{% endif %}</article>{% else %}<p class="hint">В текущем файле не найдены ЦФО для сопоставления.</p>{% endfor %}</div></section>
